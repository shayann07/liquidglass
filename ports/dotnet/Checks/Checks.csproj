<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../LiquidGlass.Skia/LiquidGlass.Skia.csproj" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.153.1" />
    <None Include="../../skia/fixtures/*.rgba" Link="fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../skia/shaders/*.sksl" Link="shaders/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="fixtures/calm-motion.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../skia/fixtures/selector-calm.json" Link="fixtures/selector-calm.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../skia/fixtures/free-button.json" Link="fixtures/free-button.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../skia/fixtures/free-button-sizes.json" Link="fixtures/free-button-sizes.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../skia/fixtures/accessory-fuse.json" Link="fixtures/accessory-fuse.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../skia/fixtures/selector-material.json" Link="fixtures/selector-material.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
